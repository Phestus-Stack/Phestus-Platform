{
  "name": "@phestus/core",
  "version": "0.1.2",
  "private": false,
  "description": "The core runtime for Phestus, providing the main interfaces, configuration, and infrastructure for building modular applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Phestus-Stack/Phestus-Platform.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Phestus-Stack/Phestus-Platform#readme",
  "keywords": [
    "phestus",
    "core",
    "backend",
    "framework",
    "modular",
    "typescript",
    "runtime"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tslib": "2.8.1",
    "tsup": "8.5.1",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@phestus/sdk": "workspace:*",
    "@phestus/event-module": "workspace:*",
    "@phestus/job-module": "workspace:*",
    "@phestus/queue-module": "workspace:*",
    "@phestus/workflow-module": "workspace:*"
  }
}