{
  "name": "@phestus/bullmq",
  "version": "0.1.0",
  "private": false,
  "description": "The BullMQ provider for Phestus, implementing queue processing and background job execution using BullMQ and Redis.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Phestus-Stack/Phestus-Platform.git",
    "directory": "packages/providers/bullmq"
  },
  "homepage": "https://github.com/Phestus-Stack/Phestus-Platform#readme",
  "keywords": [
    "phestus",
    "bullmq",
    "queue",
    "queue-provider",
    "redis",
    "background-jobs",
    "job-processing",
    "backend",
    "framework",
    "modular",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phestus/queue-module": "workspace:*",
    "@phestus/sdk": "workspace:*",
    "bullmq": "^6.3.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tslib": "2.8.1",
    "tsup": "8.5.1",
    "typescript": "5.7.3"
  }
}