{
  "name": "@phestus/express-api",
  "version": "0.1.0",
  "private": false,
  "description": "The Express API provider for Phestus, integrating Express 5 with the Phestus API and middleware modules to handle HTTP requests and route registration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Phestus-Stack/Phestus-Platform.git",
    "directory": "packages/providers/express-api"
  },
  "homepage": "https://github.com/Phestus-Stack/Phestus-Platform#readme",
  "keywords": [
    "phestus",
    "express",
    "express-5",
    "api",
    "api-provider",
    "http",
    "middleware",
    "backend",
    "framework",
    "modular",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phestus/api-module": "workspace:*",
    "@phestus/middleware-module": "workspace:*",
    "@phestus/sdk": "workspace:*",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.4.1",
    "tslib": "2.8.1",
    "tsup": "8.5.1",
    "typescript": "5.7.3"
  }
}