{
  "name": "@phestus/in-memory",
  "version": "0.1.0",
  "private": false,
  "description": "An in-memory service adapter for Phestus, providing in-memory schema definition, data storage, and query management for development, testing, and lightweight applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Phestus-Stack/Phestus-Platform.git",
    "directory": "packages/providers/in-memory"
  },
  "homepage": "https://github.com/Phestus-Stack/Phestus-Platform#readme",
  "keywords": [
    "phestus",
    "in-memory",
    "service-adapter",
    "data-storage",
    "schema",
    "query-management",
    "testing",
    "development",
    "backend",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phestus/sdk": "workspace:*",
    "@phestus/core": "workspace:*"
  },
  "devDependencies": {
    "tslib": "2.8.1",
    "tsup": "8.5.1",
    "typescript": "5.7.3"
  }
}